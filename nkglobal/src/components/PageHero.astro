---
import { Image } from 'astro:assets';
interface Props { title: string; subtitle?: string; image: ImageMetadata; imageAlt?: string; objectPosition?: string; minHeight?: string }
const { title, subtitle, image, imageAlt = '', objectPosition = 'center', minHeight = '420px' } = Astro.props;
---
<section class="page-hero" style={`--min-h:${minHeight}`}>
  <Image src={image} alt={imageAlt} class="page-hero__img" style={`object-position:${objectPosition}`} widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="page-hero__veil"></div>
  <div class="page-hero__content container">
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>
<style>
  .page-hero { position: relative; display: grid; place-items: center; min-height: var(--min-h); padding: calc(var(--header-h) + 3rem) 0 4rem; background: var(--charcoal); overflow: hidden; text-align: center; color: #fff; }
  .page-hero :global(.page-hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .page-hero__veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,20,21,.78), rgba(28,28,29,.82)); }
  .page-hero__content { position: relative; max-width: 760px; animation: hero-in .9s ease both; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
  p { margin-top: 1rem; font-size: clamp(1rem, 2vw, 1.2rem); color: var(--gold); font-weight: 300; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
</style>
