---
import Icon from './Icon.astro';
import { SITE, SOCIAL, LEGAL, WHATSAPP_DISPLAY, whatsappLink, WHATSAPP_MESSAGES } from '../config/site';
const social = SOCIAL.filter((s) => s.href);
---
<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__brand">{SITE.shortName}</p>
      <p class="footer__text">{SITE.tagline}</p>
      <p class="footer__cnpj">CNPJ: {SITE.cnpj}</p>
    </div>
    <div>
      <h2 class="footer__title">Fale Conosco</h2>
      <ul class="footer__list">
        <li><Icon name="message-circle" size={16} /><a href={whatsappLink(WHATSAPP_MESSAGES.contact)} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
        <li><Icon name="mail" size={16} /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer__title">Nosso Endereço</h2>
      <ul class="footer__list">
        <li><Icon name="map-pin" size={16} /><address>{SITE.address.map((l) => <span>{l}</span>)}</address></li>
        <li><Icon name="message-circle" size={16} /><a href={whatsappLink(WHATSAPP_MESSAGES.contact)} target="_blank" rel="noopener noreferrer">{WHATSAPP_DISPLAY}</a></li>
      </ul>
    </div>
    {social.length > 0 && <div>
      <h2 class="footer__title">Siga-nos</h2>
      <ul class="footer__social">
        {social.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}><Icon name={s.icon} size={16} /></a></li>
        ))}
      </ul>
    </div>}
  </div>
  <div class="container footer__legal">
    <p>{SITE.copyright}</p>
    <ul>
      {LEGAL.map((l) => <li>{l.href ? <a href={l.href}>{l.label}</a> : <span>{l.label}</span>}</li>)}
    </ul>
  </div>
</footer>

<style>
  .footer { background: var(--charcoal); color: var(--text-light); padding-top: 3.5rem; font-size: .8rem; }
  .footer__grid { display: grid; grid-template-columns: 1.1fr 1fr 1.1fr; gap: 2.5rem; padding-bottom: 2.5rem; }
  .footer__brand { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: #fff; margin-bottom: .8rem; }
  .footer__text { max-width: 28ch; line-height: 1.7; }
  .footer__cnpj { margin-top: 1rem; font-family: var(--font-mono); font-size: .7rem; color: #85858a; }
  .footer__title { font-family: var(--font-body); font-size: .65rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: #fff; margin-bottom: 1.1rem; }
  .footer__list { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; font-family: var(--font-mono); font-size: .76rem; }
  .footer__list li { display: flex; gap: .7rem; align-items: flex-start; }
  .footer__list :global(svg) { color: var(--gold); flex: none; margin-top: 2px; }
  .footer__list a { text-decoration: none; transition: color .2s; overflow-wrap: anywhere; }
  .footer__list a:hover { color: var(--gold); }
  address { font-style: normal; display: grid; line-height: 1.6; }
  .footer__social { list-style: none; margin: 0; padding: 0; display: flex; gap: .7rem; }
  .footer__social a { width: 36px; height: 36px; border-radius: 50%; background: #3a3a3b; color: #fff; display: grid; place-items: center; transition: background .2s, color .2s; }
  .footer__social a:hover { background: var(--gold); color: var(--ink); }
  .footer__legal { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-block: 1.4rem; border-top: 1px solid rgba(255,255,255,.08); font-family: var(--font-mono); font-size: .68rem; color: #85858a; }
  .footer__legal ul { display: flex; gap: 1.2rem; list-style: none; margin: 0; padding: 0; }
  .footer__legal a { text-decoration: none; }
  .footer__legal a:hover { color: var(--gold); }
  @media (max-width: 960px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr; gap: 2rem; } .footer__legal { padding-bottom: 5rem; } }
</style>
