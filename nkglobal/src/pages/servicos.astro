---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { hero, services, deliverablesLabel } from '../content/servicos';
---
<Layout path="/servicos" title="Serviços" description="Ecossistema integrado de excelência em negócios: diagnóstico, riscos e fraudes, treinamento, transição e visão de futuro.">
  <section class="services">
    <div class="container">
      <header class="services__head">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.title}</h1>
        <p class="services__lead">{hero.text}</p>
      </header>
      <ul class="services__grid">
        {services.map((s, i) => (
          <li class="service" data-service data-reveal style={`--d:${(i % 3) * 0.08}s`}>
            <div class="service__top">
              <span class="service__icon"><Icon name={s.icon} size={20} /></span>
              <button class="service__toggle" type="button" aria-expanded="false" aria-controls={`entregas-${i}`} aria-label={`Ver principais entregas: ${s.title}`}>
                <Icon name="chevron-down" size={16} />
              </button>
            </div>
            <h2>{s.title}</h2>
            <p class="service__text">{s.text}</p>
            <div class="service__panel" id={`entregas-${i}`} role="region" aria-label={`${deliverablesLabel}: ${s.title}`}>
              <div class="service__panel-inner">
                <h3>{deliverablesLabel}</h3>
                <ul>
                  {s.deliverables.map((d) => <li><Icon name="circle-check" size={16} />{d}</li>)}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLElement>('[data-service]').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('.service__toggle')!;
    const toggle = () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      card.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', (e) => { e.stopPropagation(); toggle(); });
    // O cartão inteiro também abre/fecha ao clicar (o botão continua sendo o controle acessível)
    card.addEventListener('click', toggle);
  });
</script>

<style>
  .services { background: radial-gradient(ellipse at 85% 10%, #1a1a1c 0%, var(--ink) 55%); color: #fff; padding: calc(var(--header-h) + 3rem) 0 clamp(4rem, 8vw, 6.5rem); min-height: 80svh; }
  .services__head { text-align: center; max-width: 640px; margin: 0 auto 3.5rem; animation: rise .9s ease both; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: .9rem 0 1.1rem; }
  .services__lead { color: var(--text-light); font-size: .95rem; }
  .services__grid { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; max-width: 1000px; align-items: start; }

  .service { background: #141416; border: 1px solid #242427; border-radius: 6px; padding: 1.4rem 1.4rem 1.8rem; cursor: pointer; transition: transform .3s, border-color .3s, background .3s; }
  .service:hover { border-color: rgba(168,153,104,.5); }
  .service.is-open { border-color: rgba(168,153,104,.6); background: #18181a; }
  .service__top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; transition: margin .3s; }
  .service.is-open .service__top { margin-bottom: 1.3rem; }
  .service__icon { width: 40px; height: 40px; border-radius: 8px; background: #212124; color: var(--gold); display: grid; place-items: center; transition: background .3s, color .3s, box-shadow .3s; }
  .service.is-open .service__icon { background: var(--gold); color: var(--ink); box-shadow: 0 6px 18px rgba(168,153,104,.25); }
  .service__toggle { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; border: 0; background: transparent; color: var(--text-light); cursor: pointer; transition: background .2s, transform .3s, color .2s; margin: -4px -4px 0 0; }
  .service__toggle:hover { background: #2a2a2d; color: #fff; }
  .service.is-open .service__toggle { background: #2a2a2d; transform: rotate(180deg); }
  .service h2 { font-size: 1.15rem; margin-bottom: .7rem; }
  .service__text { font-size: .8rem; line-height: 1.7; color: var(--text-light); }

  /* Painel de entregas: recolhido só quando há JS */
  .service__panel { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .35s ease; }
  .service__panel-inner { overflow: hidden; min-height: 0; }
  .service__panel-inner > :first-child { margin-top: 1.3rem; }
  :global(.js) .service:not(.is-open) .service__panel { grid-template-rows: 0fr; }
  .service__panel-inner { border-top: 1px solid transparent; }
  .service.is-open .service__panel-inner { border-top-color: #2a2a2d; margin-top: 1.3rem; }
  .service.is-open .service__panel-inner > :first-child { margin-top: 1.2rem; }
  .service__panel h3 { font-family: var(--font-mono); font-weight: 400; font-size: .64rem; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); margin-bottom: 1rem; }
  .service__panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .service__panel li { display: flex; gap: .7rem; align-items: flex-start; font-size: .8rem; line-height: 1.5; color: #e6e3dc; }
  .service__panel li :global(svg) { color: var(--gold); flex: none; margin-top: 1px; }

  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (max-width: 900px) { .services__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .services__grid { grid-template-columns: 1fr; } .service__top { margin-bottom: 1.4rem; } }
</style>
