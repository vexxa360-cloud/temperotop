# ============================================================
# Credenciais Mercado Pago — COPIE este arquivo para ".env"
# e preencha com os seus dados. NÃO suba o .env para o Git.
# ============================================================

# ============================================================
# PAGAMENTO DENTRO DO SITE (Checkout Transparente / Bricks)
# Precisa das DUAS credenciais abaixo (Suas integrações > Credenciais):
#   https://www.mercadopago.com.br/developers
# Use as de TESTE (TEST-... / APP_USR- de teste) para validar sem cobrar,
# e as de PRODUÇÃO quando for para o ar.
# ============================================================

# Public Key (vai para o navegador — pode ficar exposta)
MP_PUBLIC_KEY=

# Access Token (SECRETO — só no servidor, nunca no frontend)
MP_ACCESS_TOKEN=

# (Opcional) Link de pagamento pronto — só usado se você NÃO preencher o
# Access Token acima. Atenção: link SEMPRE redireciona (sai do site).
MP_PAYMENT_LINK=

# URL pública do site (usada nos redirecionamentos de retorno)
BASE_URL=http://localhost:3000

# Porta do servidor
PORT=3000

# Token de acesso ao painel administrativo (/admin?token=...)
# Em localhost, se ficar vazio, o painel é liberado só para 127.0.0.1.
# Em produção, DEFINA um token forte.
ADMIN_TOKEN=
